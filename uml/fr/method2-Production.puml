@startuml method2-Production
!theme cerulean
!include theme/method-theme.puml
title Les Petits Plats — Stratégie de filtrage (Méthode 2)\nApproche déclarative utilisant filter(), some() et applyAllFilters()

partition "Moteur de recherche" {
  start
  :query = normalizeString(query);

  note right
    normalizeString(query) — Exécute la logique de normalisation suivante :

      ◆ Retire accents et caractères spéciaux
      ◆ Convertit en minuscules
      ◆ Élimine parenthèses et espaces inutiles
      ◆ Objectif : uniformiser texte + éviter faux négatifs.
  end note

  partition "Filtrage fonctionnel" {
    :results = applyAllFilters(recipes, query);

    note right
      applyAllFilters() — Exécute la logique de filtrage suivante :

      ➤ Normalisation :
        ◆ Les champs utiles sont comparés via normalizeString().

      ➤ Conditions de correspondance :
        ◆ matchTitle(recipe, query) :
            Vérifie si le titre contient la requête normalisée.
        ◆ recipe.ingredients.some(matchIngredient) :
            Recherche un ingrédient correspondant
        ◆ matchDescription(recipe, query) :
            Analyse la description

      ➤ Règle de validation :
        ◆ La recette est retenue si AU MOINS UNE condition est vraie.
    end note
  }

  :retourner les résultats;
  stop
  note right
    ➤ Méthode 2 — Filtrage fonctionnel
      ◆ Utilisation de Array.filter() et Array.some()
      ◆ applyAll() comme logique centrale de filtrage
  end note
}

@enduml
