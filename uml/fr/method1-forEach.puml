@startuml method1-forEach
!theme cerulean
!include theme/method-theme.puml
title Les Petits Plats — Stratégie de filtrage (Méthode 1)\nApproche impérative utilisant des boucles natives

partition "Moteur de recherche" {

  start

  :query = normalizeString(query);
  
  note right
    normalizeString(query) — Exécute la logique de normalisation suivante :
      
      ◆ Retire accents et caractères spéciaux
      ◆ Convertit en minuscules
      ◆ Élimine parenthèses et espaces inutiles
      ◆ Objectif : uniformiser texte + éviter faux négatifs.
  end note

  :initialiser results = [];

  partition "Boucles natives" {
    repeat
      :Lire recette courante;
      -[#LightBlue]->
      if (Title(recipe, query)) then (oui)
        :results.push(recipe);
      else (non)
        if (Ingredients(recipe, query)) then (oui)
          :results.push(recipe);
        else (non)
          if (Description(recipe, query)) then (oui)
            :results.push(recipe);
          endif
        endif
      endif
    
    repeat while (recette suivante ?) -[#FF8C00]->
  }

  :Filtrage natif;
  note right
    Filtrage natif — Exécute la logique de filtrage suivante :

      ◆ Title(recipe, query)
      ◆ Ingredients(recipe, query)
      ◆ Description(recipe, query)
      ◆ Style impératif avec conditions imbriquées
      ◆ Moins performant et plus difficile à maintenir
  end note

  :retourner les résultats;
  stop

  note right
    ➤ Méthode 1 — Boucles natives avec fonctions nommées
      ◆ Fonctions nommées pour le comparatif avec la Méthode 2
  end note
}

@enduml
