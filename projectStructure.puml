@startuml projectStructure
!theme carbon-gray
top to bottom direction
allowmixing

' ---------------------
' Style
' ---------------------
' General style
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowStyle none

' Rectangle style
skinparam rectangle {
  RoundCorner 25
  BorderColor $PRIMARY_DARK
}

' Package style
skinparam package {
  BackgroundColor transparent
}

' Component style
skinparam component {
	BackgroundColor $GRAY_10
	BorderColor $PRIMARY_DARK
  BorderThickness 0
  FontName "Inter"
  FontSize 16
  FontStyle normal
}

' Node style
skinparam node {
	BackgroundColor $GRAY_10
	BorderColor $PRIMARY_DARK
	FontColor $PRIMARY_TEXT
	Roundcorner 0
}

' ---------------------
' Structure
' ---------------------
LesPetitsPlats -[hidden]-> Initializers
LesPetitsPlats -down-> Initializers
' Decision node for conditional flow
rectangle "match" as Decision #LightBlue
node "Success" as Success #LightGreen
node "Error" as Error #Red

' LesPetitsPlats node
package "LesPetitsPlats" as LesPetitsPlats {
  node "initApp"
}


Initializers -[hidden]->  Error
Error -up-> LesPetitsPlats : "Show Toast"

package "Initializers" as Initializers {
  folder "Setup" as Setup {
    file "Skeletons"
    file "ScrollToTop"
    file "Coordinator"
    Skeletons -down-> ScrollToTop
    ScrollToTop -down-> Coordinator
  }

  folder "Fetcher" as Fetcher {
    file "RecipeApi"
    file "Cache"
    file "Config"
    RecipeApi -down-> Cache
    Cache -down-> Config
  }

  folder "Recipes" as Recipes {
    file "Build"
    file "Results"
    Build -down-> Results
  }
  
  Setup -right-> Fetcher
  Fetcher -right-> Recipes  
}

Results -right-> Error
Results -down-> Decision : "Show Recipes"
Decision -down-> Success : "Hide Skeletons"
Success -right-> Components

package "Components" as Components {
  file "ResultsCounter"
  file "Header" as headerComponent
  
  package "Search" as searchManager {
    file "SearchManager"
    file "SearchElements"
    file "SearchRender"
    file "SearchState"
    SearchManager -down-> SearchElements
    SearchElements -down-> SearchRender
    SearchRender -down-> SearchState
  }
  
  package "Cards" as cardsManager {
    file "CardsManager"
    file "CardsElements"
    file "CardsRender"
    file "CardsState"
    CardsManager -down-> CardsElements
    CardsElements -down-> CardsRender
    CardsRender -down-> CardsState
  }
  
  package "Dropdowns" as dropdownsManager {
    file "DropdownsManager"
    file "DropdownsElements"
    file "DropdownsRender"
    file "DropdownsState"
    DropdownsManager -down-> DropdownsElements
    DropdownsElements -down-> DropdownsRender
    DropdownsRender -down-> DropdownsState
  }
  
  package "Filters" as filtersManager {
    file "FiltersManager"
    file "FiltersElements"
    file "FiltersRender"
    file "FiltersState"
    FiltersManager -down-> FiltersElements
    FiltersElements -down-> FiltersRender
    FiltersRender -down-> FiltersState
  }

  package "Skeletons" as skeletonsManager {
    file "SkeletonsManager"
    file "SkeletonsRender"
    file "SkeletonsState"
    SkeletonsManager -down-> SkeletonsRender
    SkeletonsRender -down-> SkeletonsState
  }
}
