{
  "name": "lespetitplats",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "OpenClassrooms",
  "type": "module",
  "scripts": {
    "dev": "pkill -f 'vite' || true; vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage --run",
    "lint": "npm run lint:eslint && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:eslint": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:css": "stylelint '**/*.css' --ignore-pattern '**/*.min.css' --ignore-pattern '**/benchmark-results/**' --ignore-pattern '**/dist/**' --ignore-pattern '**/@dist/**' --ignore-pattern '**/Report/**'",
    "lint:html": "find . -name '*.html' -not -path './benchmark-results/*' -not -path './Report/*' -not -path './node_modules/*' -not -path './dist/*' -not -path './@dist/*' -not -path './.stryker-tmp/*' | xargs html-validate || true",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore Report",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs}\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "analyze": "vite build --mode analyze",
    "generate:pwa-assets": "pwa-assets-generator",
    "clean": "rm -rf dist node_modules/.vite benchmark-results Report .stryker-tmp lighthouse",
    "benchmark": "NODE_OPTIONS='--max-old-space-size=4096' npx tsx viteTest/Benchmarks/reporting/index.js",
    "jsben": "npx tsx viteTest/Jsben/setup.js",
    "optimize:images": "node scripts/optimize-images.js",
    "lighthouse": "npm run build && (npm run preview &) && sleep 5 && node scripts/lighthouse.js http://localhost:5173/OC-LesPetitPlats/ && pkill -f 'vite preview' || true"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "neverthrow": "^8.2.0",
    "query-string": "^9.3.1",
    "remixicon": "^4.7.0",
    "tailwindcss": "^4.1.16",
    "tiny-lru": "^11.4.5",
    "toastify-js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@stryker-mutator/core": "^9.3.0",
    "@stryker-mutator/vitest-runner": "^9.3.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitest/coverage-v8": "^4.0.14",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "chroma-js": "^3.1.2",
    "chrome-launcher": "^1.2.1",
    "clean-css": "^5.3.3",
    "cli-progress": "^3.12.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.4.0",
    "handlebars": "^4.7.8",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^10.4.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^27.3.0",
    "lighthouse": "^13.0.1",
    "lucide": "^0.561.0",
    "madge": "^8.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdownlint-cli": "^0.47.0",
    "marked": "^17.0.1",
    "moment": "^2.30.1",
    "numeral": "^2.0.6",
    "ora": "^9.0.0",
    "plotly.js-dist-min": "^3.3.0",
    "prettier": "^3.7.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "simple-statistics": "^7.8.8",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "systeminformation": "^5.27.14",
    "tinybench": "^6.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vite-tsconfig-paths": "^6.0.1",
    "vitest": "^4.0.14"
  },
  "overrides": {
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
    "source-map": "^0.7.4",
    "@vite-pwa/assets-generator": {
      "sharp": "0.34.5"
    }
  }
}
