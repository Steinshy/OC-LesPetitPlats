{
  "name": "lespetitplats",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "OpenClassrooms",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pkill -f 'vite' || true; vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm run lint:eslint && pnpm run lint:css && pnpm run lint:html",
    "lint:eslint": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:css": "stylelint '**/*.css' --ignore-pattern '**/*.min.css' --ignore-pattern '**/dist/**' --ignore-pattern '**/@dist/**'",
    "lint:html": "find . -name '*.html' -not -path './node_modules/*' -not -path './dist/*' -not -path './@dist/*' | xargs html-validate || true",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs}\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "update:check": "ncu",
    "update:interactive": "ncu -i",
    "update:all": "ncu -u"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "query-string": "^9.3.1",
    "remixicon": "^4.9.1",
    "tailwindcss": "^4.2.0",
    "tiny-lru": "^11.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "17.3.0",
    "html-validate": "10.8.0",
    "npm-check-updates": "^19.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.1",
    "ts-api-utils": "^2.5.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"]
  }
}
