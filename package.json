{
  "name": "lespetitplats",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "OpenClassrooms",
  "type": "module",
  "scripts": {
    "dev": "pkill -f 'vite' || true; vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run lint:css && npm run lint:html",
    "lint:eslint": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:css": "stylelint '**/*.css' --ignore-pattern '**/*.min.css' --ignore-pattern '**/dist/**' --ignore-pattern '**/@dist/**'",
    "lint:html": "find . -name '*.html' -not -path './node_modules/*' -not -path './dist/*' -not -path './@dist/*' | xargs html-validate || true",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs}\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "query-string": "^9.3.1",
    "remixicon": "^4.7.0",
    "tailwindcss": "^4.1.16",
    "tiny-lru": "^11.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.4.0",
    "html-validate": "^10.4.0",
    "prettier": "^3.7.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vite-tsconfig-paths": "^6.0.3"
  }
}
