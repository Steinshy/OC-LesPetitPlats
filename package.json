{
  "name": "lespetitplats",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "OpenClassrooms",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pkill -f 'vite' || true; vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm run lint:eslint && pnpm run lint:css && pnpm run lint:html",
    "lint:eslint": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:css": "stylelint '**/*.css' --ignore-pattern '**/*.min.css' --ignore-pattern '**/dist/**' --ignore-pattern '**/@dist/**'",
    "lint:html": "find . -name '*.html' -not -path './node_modules/*' -not -path './dist/*' -not -path './@dist/*' | xargs html-validate || true",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs}\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "update:check": "ncu",
    "update:interactive": "ncu -i",
    "update:all": "ncu -u"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "query-string": "^9.4.1",
    "remixicon": "^4.9.1",
    "tailwindcss": "^4.3.3",
    "tiny-lru": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "63.2.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "17.7.0",
    "html-validate": "11.5.6",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "ts-api-utils": "^2.5.0",
    "vite": "^8.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
