{
  "name": "lespetitplats",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "OpenClassrooms",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "npm run lint:eslint && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:eslint": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:css": "stylelint '**/*.css' --ignore-pattern '**/*.min.css' --ignore-pattern '**/coverage/**' --ignore-pattern '**/dist/**' --ignore-pattern '**/@dist/**'",
    "lint:html": "find . -name '*.html' -not -path './coverage/*' -not -path './Benchmark/*' -not -path './node_modules/*' -not -path './dist/*' -not -path './@dist/*' | xargs html-validate || true",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs}\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "analyze": "vite build --mode analyze",
    "optimize:images": "node scripts/optimizeImages.js",
    "clean": "rm -rf dist node_modules/.vite coverage Benchmark .stryker-tmp",
    "benchmark": "NODE_OPTIONS='--max-old-space-size=4096' node viteTest/Benchmarks/utils/reporting/generateReport.js",
    "lighthouse:dev": "npm run dev & sleep 3 && node scripts/lighthouse.js http://localhost:5173/OC-LesPetitPlats/ && pkill -f 'vite' || true",
    "lighthouse:preview": "npm run build && npm run preview & sleep 3 && node scripts/lighthouse.js http://localhost:4173/OC-LesPetitPlats/ && pkill -f 'vite preview' || true"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "tailwindcss": "^4.1.16",
    "tiny-lru": "^11.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@stryker-mutator/core": "^9.3.0",
    "@stryker-mutator/vitest-runner": "^9.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "chroma-js": "^3.1.2",
    "chrome-launcher": "^1.2.1",
    "cli-progress": "^3.12.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.1.7",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^1.0.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "globals": "^16.4.0",
    "handlebars": "^4.7.8",
    "html-validate": "^9.0.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^27.0.1",
    "lighthouse": "^13.0.1",
    "lucide": "^0.554.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdownlint-cli": "^0.46.0",
    "marked": "^14.1.4",
    "moment": "^2.30.1",
    "numeral": "^2.0.6",
    "ora": "^9.0.0",
    "plotly.js-dist-min": "^3.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "puppeteer": "^24.29.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.33.5",
    "simple-statistics": "^7.8.8",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "tinybench": "^5.1.0",
    "vite": "^7.1.7",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-linter": "^3.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0"
  }
}
