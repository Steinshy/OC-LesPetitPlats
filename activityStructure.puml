@startuml activityDiagram
!theme carbon-gray
top to bottom direction

' ---------------------
' General style
' ---------------------
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowStyle none

' Rectangle style
skinparam rectangle {
  RoundCorner 25
  BorderColor #2C3E50
}

' Package style
skinparam package {
  BackgroundColor transparent
}

' Component style
skinparam component {
  BackgroundColor #F5F5F5
  BorderColor #2C3E50
  BorderThickness 0
  FontName "Inter"
  FontSize 16
  FontStyle normal
}

' Node style
skinparam node {
  BackgroundColor #F5F5F5
  BorderColor #2C3E50
  FontColor #2C3E50
  Roundcorner 0
}

' ---------------------
' Activity Diagram
' ---------------------
folder "1) States" as StatesBlock {
  file "a. Recipes" as Recipes
  file "b. Render" as Render
  
  Recipes -> Render #6BCB77
}

folder "2) Setup" as SetupBlock {
  file "a. Filters" as SetupFilters
  file "b. Dropdowns" as SetupDropdowns
  file "c. SearchBar" as SetupSearchBar
  file "d. Results Counter" as SetupCounter
  file "e. Cards" as SetupCards
  file "f. URL State" as UpdateURLState
  
  SetupFilters -down-> SetupDropdowns
  SetupDropdowns -down-> SetupSearchBar
  SetupSearchBar -down-> SetupCounter
  SetupCounter -down-> SetupCards
  SetupCards -down-> UpdateURLState
}

folder "3) Interactions" as InteractionsBlock {
  file "a. Click on Filters" as FiltersInteraction
  file "b. Click on Dropdowns" as DropdownsInteraction
  file "c. Type on Search" as SearchInteraction
  
  FiltersInteraction -[hidden]-> DropdownsInteraction
  DropdownsInteraction -[hidden]-> SearchInteraction
}

folder "4) Events" as EventsBlock {
  rectangle "a. Filters: stateChanged" as FiltersStateChangedEvent #LightGreen
  rectangle "b. Dropdowns: itemToggled" as DropdownEvent #LightBlue
  rectangle "c. Filters: searchChanged" as FiltersSearchEvent #LightSkyBlue

  FiltersStateChangedEvent -[hidden]-> DropdownEvent
  DropdownEvent -[hidden]-> FiltersSearchEvent
}

folder "5) Filters" as FiltersBlock {
  file "a. Apply All Filters" as ApplyAllFilters
  file "b. Filter By Field" as FilterByField
  file "c. Filter By Search" as FilterBySearch

  ApplyAllFilters -[hidden]-> FilterByField
  FilterByField -[hidden]-> FilterBySearch
}

folder "6) Coordinator" as CoordinatorBlock {
  file "a. Update UI" as UpdateUI
}

' ---------------------
' StatesBlock -> Setup
' ---------------------
StatesBlock -[hidden]-> SetupBlock
CoordinatorBlock -[hidden]-> EventsBlock
Render -> SetupFilters #6BCB77

' ---------------------
' Setup -> User Interactions
' ---------------------
SetupFilters -right-> FiltersInteraction
SetupDropdowns -right-> DropdownsInteraction
SetupSearchBar -right-> SearchInteraction

' ---------------------
' EventsBlock -> Filters
' ---------------------
FiltersInteraction -> FiltersStateChangedEvent
DropdownsInteraction -> DropdownEvent
SearchInteraction -> FiltersSearchEvent

' ---------------------
' Filters -> Coordinator
' ---------------------
FiltersStateChangedEvent -right-> ApplyAllFilters
DropdownEvent -right-> FilterByField
FiltersSearchEvent -right-> FilterBySearch

' ---------------------
' Coordinator -> Render
' ---------------------
FiltersBlock -up-> CoordinatorBlock
UpdateUI -> Render

@enduml
